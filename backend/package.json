{
  "name": "medicare-backend",
  "version": "1.0.0",
  "description": "Medicare Rajshahi Healthcare Platform - REST API Backend",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test-db": "node test-db.js",
    "seed": "node seed/index.js",
    "seed:doctors": "node -e \"require('dotenv').config(); const connectDB = require('./config/db'); const seedDoctors = require('./seed/doctors'); connectDB().then(() => seedDoctors()).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "import:medicbd": "node seed/importMedicbdDoctors.js",
    "migrate": "node scripts/migration/run_migration.js",
    "migrate:step": "node scripts/migration/run_migration.js --step",
    "migrate:from": "node scripts/migration/run_migration.js --from",
    "migrate:validate": "node scripts/migration/run_migration.js --validate"
  },
  "dependencies": {
    "@supabase/server": "^1.9.0",
    "@supabase/supabase-js": "^2.117.2",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "medicare-rajshahi": "file:..",
    "mongoose": "^8.13.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^8.0.0-rc.19",
    "supertest": "^7.3.0"
  }
}
